{
	"$schema": "http://json-schema.org/draft-07/schema",
	"$id": "quickreference.json",
	"title": "Quick Reference",
	"type": "object",
	"properties": {
		"quickReference": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string"
					},
					"entries": {
						"type": "array",
						"minItems": 1,
						"items": {
							"$ref": "entry.json"
						}
					}
				},
				"required": [
					"name",
					"entries"
				],
				"additionalProperties": false
			}
		},
		"pageReferences": {
			"type": "object",
			"minProperties": 1,
			"description": "Reference notes keyed by page topic, shown in the Quick Reference tabs.",
			"additionalProperties": {
				"type": "object",
				"properties": {
					"source": {
						"type": "string"
					},
					"page": {
						"type": "integer"
					},
					"entries": {
						"type": "array",
						"items": {
							"$ref": "entry.json"
						}
					}
				},
				"required": [
					"entries"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"quickReference",
		"pageReferences"
	],
	"additionalProperties": false
}
